# IIM Jobs Agent - Credentials
# Copy this file to .env and fill in your details

IIMJOBS_EMAIL=your_email@example.com
IIMJOBS_PASSWORD=your_password_here

# Your personalized feed URL from iimjobs.com
# Find it by opening your job feed in the browser and copying the URL.
# Example: https://www.iimjobs.com/jobfeed?minexp=2&maxexp=3&_r=fi72stfujq5
IIMJOBS_FEED_URL=https://www.iimjobs.com/jobfeed?minexp=2&maxexp=3&_r=fi72stfujq5
